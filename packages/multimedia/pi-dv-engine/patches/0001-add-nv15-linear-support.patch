+// ---- NV15 linear reads (4 x 10-bit packed in 5 bytes, little-endian) ----
+uint nv15_sample(usamplerBuffer buf, uint base_word, uint pitch_words, uint n, uint row)
+{
+    uint bit = n * 10u;
+    uint idx = base_word + row * pitch_words + (bit >> 5);
+    uint sh = bit & 31u;
+    uint lo = texelFetch(buf, int(idx)).r >> sh;
+    uint hi = sh > 22u ? (texelFetch(buf, int(idx + 1u)).r << (32u - sh)) : 0u;
+    return (lo | hi) & 1023u;
+}
+
+uvec2 nv15_even2(usamplerBuffer buf, uint base_word, uint pitch_words, uint q, uint row)
+{
+    uint bit = q * 20u;
+    uint idx = base_word + row * pitch_words + (bit >> 5);
+    uint sh = bit & 31u;
+    uint v = texelFetch(buf, int(idx)).r >> sh;
+    if (sh > 12u)
+        v |= texelFetch(buf, int(idx + 1u)).r << (32u - sh);
+    return uvec2(v & 1023u, (v >> 10u) & 1023u);
+}
+
+uvec4 nv15_4(usamplerBuffer buf, uint base_word, uint pitch_words, uint n, uint row)
+{
+    uint bit = n * 10u;
+    uint idx = base_word + row * pitch_words + (bit >> 5);
+    uint sh = bit & 31u;
+    uint w0 = texelFetch(buf, int(idx)).r;
+    uint w1 = texelFetch(buf, int(idx + 1u)).r;
+    uint lo32 = (w0 >> sh) | (sh != 0u ? (w1 << (32u - sh)) : 0u);
+    uint s3;
+    if (sh == 0u) {
+        s3 = (w0 >> 30u) | (w1 << 2u);
+    } else {
+        uint sh3 = sh - 2u;
+        s3 = w1 >> sh3;
+        if (sh3 > 22u)
+            s3 |= texelFetch(buf, int(idx + 2u)).r << (32u - sh3);
+    }
+    return uvec4(lo32 & 1023u, (lo32 >> 10u) & 1023u, (lo32 >> 20u) & 1023u, s3 & 1023u);
+}
+

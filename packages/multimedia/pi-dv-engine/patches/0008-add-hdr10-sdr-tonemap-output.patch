+static double pq_oetf_d(double lin)
+{
+    if (lin <= 0.0)
+        return 0.0;
+    const double m1 = 2610.0 / 16384.0;
+    const double m2 = 2523.0 / 32.0;
+    const double c1 = 3424.0 / 4096.0;
+    const double c2 = 2413.0 / 128.0;
+    const double c3 = 2392.0 / 128.0;
+    double pw = pow(lin, m1);
+    return pow((c1 + c2 * pw) / (1.0 + c3 * pw), m2);
+}
+
+static int mat3_inv(const double m[9], double inv[9])
+{
+    double a = m[0], b = m[1], c = m[2], d = m[3], e = m[4], f = m[5], g = m[6], h = m[7], i = m[8];
+    double v[9] = {e * i - f * h, c * h - b * i, b * f - c * e,
+                   f * g - d * i, a * i - c * g, c * d - a * f,
+                   d * h - e * g, b * g - a * h, a * e - b * d};
+    double det = a * v[0] + b * v[3] + c * v[6];
+    if (!isfinite(det) || fabs(det) < 1e-12)
+        return -1;
+    for (int k = 0; k < 9; k++)
+        inv[k] = v[k] / det;
+    return 0;
+}
+
+static void tm_params(const struct pi_engine *e, const AVDOVIMetadata *md, struct params *q)
+{
+    memset(q->tm_ycc, 0, sizeof(q->tm_ycc));
+    memset(q->tm_lms, 0, sizeof(q->tm_lms));
+    memset(q->tm_eetf, 0, sizeof(q->tm_eetf));
+    memset(q->tm_cfg, 0, sizeof(q->tm_cfg));
+    if (e->o.output_mode == PI_OUT_DV_STANDARD || !md)
+        return;
+    const AVDOVIColorMetadata *cm = av_dovi_get_color(md);
+    for (int r = 0; r < 3; r++) {
+        for (int c = 0; c < 3; c++)
+            q->tm_ycc[r][c] = (float)av_q2d(cm->ycc_to_rgb_matrix[3 * r + c]);
+        q->tm_ycc[r][3] = (float)av_q2d(cm->ycc_to_rgb_offset[r]);
+    }
+    /* Common LMS -> linear BT.2020 RGB, composed with the RPU's rgb_to_lms_matrix */
+    static const double bt2020_to_lms[9] = {
+        7222.0 / 16384.0, 8771.0 / 16384.0,  390.0 / 16384.0,
+        2654.0 / 16384.0, 12430.0 / 16384.0, 1300.0 / 16384.0,
+           0.0 / 16384.0,   422.0 / 16384.0, 15962.0 / 16384.0,
+    };
+    double lms_to_2020[9], rpu_lms[9], m_lin[9];
+    for (int k = 0; k < 9; k++)
+        rpu_lms[k] = av_q2d(cm->rgb_to_lms_matrix[k]);
+    if (mat3_inv(bt2020_to_lms, lms_to_2020) == 0) {
+        for (int r = 0; r < 3; r++)
+            for (int c = 0; c < 3; c++) {
+                double sum = 0.0;
+                for (int k = 0; k < 3; k++)
+                    sum += lms_to_2020[3 * r + k] * rpu_lms[3 * k + c];
+                m_lin[3 * r + c] = sum;
+                q->tm_lms[r][c] = (float)sum;
+            }
+    } else {
+        for (int r = 0; r < 3; r++)
+            q->tm_lms[r][r] = 1.0f;
+    }
+    int need_lin_lms = (cm->signal_color_space != 0);
+    if (!need_lin_lms) {
+        for (int r = 0; r < 3; r++)
+            for (int c = 0; c < 3; c++)
+                if (fabs(m_lin[3 * r + c] - (r == c ? 1.0 : 0.0)) > 1e-2)
+                    need_lin_lms = 1;
+    }
+    /* Per-frame RPU L1 brightness metadata (fallback to source_min/max_pq) */
+    double lb = cm->source_min_pq / 4095.0;
+    double lw = cm->source_max_pq / 4095.0;
+    for (int i = 0; i < md->num_ext_blocks; i++) {
+        const AVDOVIDmData *ext = av_dovi_get_ext(md, i);
+        if (ext && ext->level == 1) {
+            lb = ext->l1.min_pq / 4095.0;
+            lw = ext->l1.max_pq / 4095.0;
+            break;
+        }
+    }
+    if (lb < 0.0 || lb > 0.05)
+        lb = 0.0;
+    if (lw < 0.508 || lw > 1.0)
+        lw = (cm->source_max_pq >= 2080 && cm->source_max_pq <= 4095) ? (cm->source_max_pq / 4095.0) : 0.7518;

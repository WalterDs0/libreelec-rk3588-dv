diff --git a/engine/shaders/p2_pack.frag b/engine/shaders/p2_pack.frag
index 1111111..2222222 100644
--- a/engine/shaders/p2_pack.frag
+++ b/engine/shaders/p2_pack.frag
@@ -52,6 +52,8 @@ layout(constant_id = 8) const uint OVERLAY = 0;
 // the rows the metadata packets reach, so neither is tested.
 layout(constant_id = 9) const uint INTERIOR = 0;
 layout(constant_id = 10) const uint NV15 = 0;
+// Output mode: 0 = DV tunnel (XRGB8888), 1 = HDR10 (XRGB2101010), 2 = SDR/WCG-SDR (XRGB2101010)
+layout(constant_id = 11) const uint OUTMODE = 0;
 layout(binding = 16) uniform sampler2D overlay_codes;   // PO: (Y, Cb, Cr) x alpha / 4096, alpha
 
 uint packet_byte(uint i) { return (P.packets[i >> 4][(i >> 2) & 3u] >> (8u * (i & 3u))) & 255u; }
@@ -76,6 +78,109 @@ uint luma(uint base, uint e)
     return uint(clamp(t >> 4, 0, 4095));
 }
 
+vec3 pq_eotf(vec3 v)
+{
+    const float m1 = 2610.0 / 16384.0;
+    const float m2 = 2523.0 / 32.0;
+    const float c1 = 3424.0 / 4096.0;
+    const float c2 = 2413.0 / 128.0;
+    const float c3 = 2392.0 / 128.0;
+    vec3 p = pow(max(v, vec3(0.0)), vec3(1.0 / m2));
+    return pow(max(p - c1, vec3(0.0)) / max(c2 - c3 * p, vec3(1e-7)), vec3(1.0 / m1));
+}
+
+float pq_eotf1(float v)
+{
+    const float m1 = 2610.0 / 16384.0;
+    const float m2 = 2523.0 / 32.0;
+    const float c1 = 3424.0 / 4096.0;
+    const float c2 = 2413.0 / 128.0;
+    const float c3 = 2392.0 / 128.0;
+    float p = pow(max(v, 0.0), 1.0 / m2);
+    return pow(max(p - c1, 0.0) / max(c2 - c3 * p, 1e-7), 1.0 / m1);
+}
+
+vec3 pq_oetf(vec3 v)
+{
+    const float m1 = 2610.0 / 16384.0;
+    const float m2 = 2523.0 / 32.0;
+    const float c1 = 3424.0 / 4096.0;
+    const float c2 = 2413.0 / 128.0;
+    const float c3 = 2392.0 / 128.0;
+    vec3 pw = pow(max(v, vec3(0.0)), vec3(m1));
+    return pow((c1 + c2 * pw) / (1.0 + c3 * pw), vec3(m2));
+}
+
+float pq_oetf1(float v)
+{
+    const float m1 = 2610.0 / 16384.0;
+    const float m2 = 2523.0 / 32.0;
+    const float c1 = 3424.0 / 4096.0;
+    const float c2 = 2413.0 / 128.0;
+    const float c3 = 2392.0 / 128.0;
+    float pw = pow(max(v, 0.0), m1);
+    return pow((c1 + c2 * pw) / (1.0 + c3 * pw), m2);
+}
+
+float bayer4x4(uint x, uint y)
+{
+    uint a = (((x ^ y) & 1u) << 3u) | ((y & 1u) << 2u) | ((((x ^ y) & 2u) >> 1u) << 1u) | ((y & 2u) >> 1u);
+    return (float(a) + 0.5) * (1.0 / 16.0) - 0.5;
+}
+
+uint tonemap_pixel(uint x, uint y, uint yy, uint cb, uint cr)
+{
+    vec3 s = vec3(float(yy), float(cb), float(cr)) * (1.0 / 4096.0) -
+             vec3(P.tm_ycc[0].w, P.tm_ycc[1].w, P.tm_ycc[2].w);
+    vec3 nl = clamp(vec3(dot(P.tm_ycc[0].xyz, s), dot(P.tm_ycc[1].xyz, s), dot(P.tm_ycc[2].xyz, s)), 0.0, 1.0);
+    uint flags = uint(P.tm_cfg.z + 0.5);
+    vec3 enc;
+    if (OUTMODE == 1u && (flags & 1u) == 0u) {
+        enc = nl;
+    } else {
+        vec3 lin = pq_eotf(nl);
+        vec3 rgb = max(vec3(dot(P.tm_lms[0].xyz, lin), dot(P.tm_lms[1].xyz, lin), dot(P.tm_lms[2].xyz, lin)),
+                       vec3(0.0));
+        if ((flags & 2u) != 0u) {
+            float mx = max(rgb.r, max(rgb.g, rgb.b));
+            if (mx > 1e-7) {
+                float e_in = pq_oetf1(mx);
+                float lb = P.tm_eetf.x;
+                float span = max(P.tm_eetf.y - lb, 1e-5);
+                float e1 = clamp((e_in - lb) / span, 0.0, 1.0);
+                float ks = P.tm_eetf.w;
+                float max_lum = P.tm_eetf.z;
+                float e2 = e1;
+                if (e1 > ks) {
+                    float t = (e1 - ks) / max(1.0 - ks, 1e-5);
+                    float t2 = t * t;
+                    float t3 = t2 * t;
+                    e2 = (2.0 * t3 - 3.0 * t2 + 1.0) * ks +
+                         (t3 - 2.0 * t2 + t) * (1.0 - ks) +
+                         (-2.0 * t3 + 3.0 * t2) * max_lum;
+                }
+                float e3 = e2 + P.tm_cfg.w * pow(1.0 - e2, 4.0);
+                float e4 = e3 * span + lb;
+                rgb *= (pq_eotf1(e4) / mx);
+            }
+        }
+        if (OUTMODE == 1u) {
+            enc = pq_oetf(clamp(rgb, 0.0, 1.0));
+        } else {
+            rgb /= max(P.tm_cfg.x, 1e-5);
+            if ((flags & 4u) != 0u) {
+                rgb = vec3( 1.6604910 * rgb.r - 0.5876411 * rgb.g - 0.0728499 * rgb.b,
+                           -0.1245505 * rgb.r + 1.1328999 * rgb.g - 0.0083494 * rgb.b,
+                           -0.0181508 * rgb.r - 0.1005789 * rgb.g + 1.1187297 * rgb.b);
+            }
+            enc = pow(clamp(rgb, 0.0, 1.0), vec3(P.tm_cfg.y));
+        }
+    }
+    float d = bayer4x4(x, y) * (1.0 / 1023.0);
+    uvec3 q = uvec3(clamp(round((enc + d) * 1023.0), 0.0, 1023.0));
+    return (q.r << 20u) | (q.g << 10u) | q.b;
+}
+
 uint finish(uint x, uint y, uint yy, uint c)
 {
     if ((ABLATE & 32u) != 0u)
@@ -282,6 +387,11 @@ void pack_block(uint x, uint y, uvec4 yy, uvec4 c, out uvec2 top, out uvec2 bott
 {
     if (OVERLAY != 0u)
         overlay(x, y, yy, c);
+    if (OUTMODE != 0u) {
+        top = uvec2(tonemap_pixel(x, y, yy.x, c.x, c.y), tonemap_pixel(x + 1u, y, yy.y, c.x, c.y));
+        bottom = uvec2(tonemap_pixel(x, y + 1u, yy.z, c.z, c.w), tonemap_pixel(x + 1u, y + 1u, yy.w, c.z, c.w));
+        return;
+    }
     top = uvec2(finish(x, y, yy.x, c.x), finish(x + 1u, y, yy.y, c.y));
     bottom = uvec2(finish(x, y + 1u, yy.z, c.z), finish(x + 1u, y + 1u, yy.w, c.z, c.w));
 }
@@ -317,6 +427,11 @@ void main()
     // nothing else fetched; pass 1 didn't reconstruct these rows. A separate
     // pipeline, so the main one's code is untouched by it.
     if (BARS != 0u) {
+        if (OUTMODE != 0u && OVERLAY == 0u) {
+            o_even = uvec2(0u);
+            o_odd = uvec2(0u);
+            return;
+        }
         pack_block(x, y0, uvec4(P.black.x), P.black.yzyz, o_even, o_odd);
         return;
     }

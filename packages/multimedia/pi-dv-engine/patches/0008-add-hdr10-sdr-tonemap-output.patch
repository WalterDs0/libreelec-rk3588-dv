From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: momokind <momokind2002@gmail.com>
Date: Wed, 25 Nov 2026 19:45:00 +0800
Subject: [PATCH] Add HDR10 and 10-bit SDR/WCG-SDR dynamic tone-mapping output modes

Extend pi-dv-engine with two non-tunnel 10-bit XRGB2101010 output modes
(PI_OUT_HDR10 and PI_OUT_SDR) in P2 (p2_pack.frag), reusing the full P0/P1
Dolby Vision reconstruction pipeline (Profile 5 IPTPQc2, Profile 7 FEL/MEL,
Profile 8.1, NV15 zero-copy):

- PI_OUT_HDR10: converts reconstructed 12-bit DV signal to ST.2084 PQ BT.2020
  RGB (fast path without EOTF/OETF round-trip for YCbCr passthrough when no
  tone mapping is requested; full PQ -> linear BT.2020 -> optional BT.2390 L1
  EETF -> PQ for Profile 5 IPTPQc2 or peak-limited HDR10 displays) and packs
  10-bit XRGB2101010 with 4x4 ordered Bayer dithering.
- PI_OUT_SDR: converts reconstructed 12-bit DV signal to linear BT.2020 RGB,
  applies per-frame RPU L1 ITU-R BT.2390 EETF dynamic tone mapping to the
  configured target peak luminance, optionally converts BT.2020 -> BT.709
  (or preserves BT.2020 for WCG-SDR), encodes with Gamma 2.2 or 2.4, and
  packs 10-bit XRGB2101010 with ordered dithering.
---
 engine/pi_engine.c         | 154 ++++++++++++++++++++++++++++++++++++++++++---
 engine/pi_engine.h         |  20 ++++++
 engine/shaders/common.glsl |   4 ++
 engine/shaders/p2_pack.frag | 105 +++++++++++++++++++++++++++++++
 4 files changed, 275 insertions(+), 8 deletions(-)

diff --git a/engine/pi_engine.h b/engine/pi_engine.h
index 1111111..2222222 100644
--- a/engine/pi_engine.h
+++ b/engine/pi_engine.h
@@ -88,6 +88,18 @@ enum pi_filters { PI_FILTERS_CB1 = 0, PI_FILTERS_PHASE = 1 };
  * Every option but bilinear reads more of the EL in both passes. */
 enum pi_el_upscale { PI_EL_BILINEAR = 0, PI_EL_ANNEX_B = 1, PI_EL_BICUBIC = 2, PI_EL_LANCZOS = 3 };
 
+/* Output signal format produced by P2:
+ *   DV_STANDARD  8-bit RGB HDMI tunnel (default, existing behaviour)
+ *   HDR10        10-bit XRGB2101010 ST.2084 PQ BT.2020
+ *   SDR          10-bit XRGB2101010 BT.2390 L1 tone-mapped SDR / WCG-SDR */
+enum pi_output_mode { PI_OUT_DV_STANDARD = 0, PI_OUT_HDR10 = 1, PI_OUT_SDR = 2 };
+
+/* Target colour gamut for PI_OUT_SDR. */
+enum pi_sdr_gamut { PI_GAMUT_BT709 = 0, PI_GAMUT_BT2020 = 1 };
+
+/* Target transfer function for PI_OUT_SDR. */
+enum pi_sdr_gamma { PI_GAMMA_22 = 0, PI_GAMMA_24 = 1 };
+
 enum pi_log_level { PI_LOG_ERROR = 0, PI_LOG_WARNING = 1, PI_LOG_INFO = 2, PI_LOG_DEBUG = 3 };
 
 /* Measurement only (pi_options.measure). */
@@ -115,6 +127,10 @@ struct pi_options {
     int profile;                  /* GPU timestamps per pass (pi_output_stats) */
     unsigned measure;             /* PI_MEASURE_* */
     unsigned ablate;              /* p2_pack.frag ABLATE: measurement only */
+    enum pi_output_mode output_mode;
+    unsigned target_nits;         /* 0: auto (HDR10 passthrough / SDR 203 nits); else 50..10000 */
+    enum pi_sdr_gamut sdr_gamut;
+    enum pi_sdr_gamma sdr_gamma;
 };
 void pi_options_default(struct pi_options *o);
 

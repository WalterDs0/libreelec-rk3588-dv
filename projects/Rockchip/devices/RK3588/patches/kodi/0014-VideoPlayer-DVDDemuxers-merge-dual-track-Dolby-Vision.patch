+struct AVCodecParameters;
+struct AVFormatContext;
+struct dvbridge_rpu_probe;
+
+/*!
+ * \brief Joins the two video tracks of a Dolby Vision stream into the one-track form
+ *
+ * Dolby Vision profile 7 can come in two video tracks: the base layer, and the enhancement layer
+ * with the RPU. UHD Blu-ray carries it so in its transport stream, Matroska files made of a disc
+ * may keep the two tracks, and MP4 files have them so in the dual-track carriage of Dolby's
+ * specification (Annex C of "Dolby Vision Streams Within the ISO Base Media File Format"). A
+ * player that opens the first video track plays HDR10. Everything after the demuxer (the decoder,
+ * the split and the pairing of the layers) takes the one-track form that dovi_tool makes of the
+ * two and that one-track Matroska files carry: after the units of the base layer of an access unit
+ * come the units of the enhancement layer, each inside a unit of type 63, and the RPU, a unit of
+ * type 62, as it is.
+ *
+ * This class finds the two tracks and makes that form while the stream is read. The two tracks
+ * have their access units in the same order and with the same decoding times (not the same
+ * presentation times: the layers may be coded with different picture orders, which the pairing
+ * of the decoded pictures resolves; for it a joined packet says when its enhancement access
+ * unit is presented, see LAYER_TIME). An access unit that has no time of its own (a PES packet may
+ * hold more than one) has the time that follows from the unit before it in its track: that time
+ * plus that duration. Matroska gives no decoding times at all; there the time by which two packets
+ * pair is made from the presentation times of each track (see REORDER). The times of the
+ * enhancement track are taken to the time base of the base track.
+ *
+ * (Hades) Where the container gives decoding times, the two tracks may also have them a constant
+ * apart: the same pictures in the same order, each layer with a decoding delay of its own (an
+ * MP4 file gives each track its own decoding times; a disc may be so, see the case CroqueMr found
+ * after a seek). Paired by equal decoding times, every base packet would then get the
+ * enhancement access unit of another picture, and the first ones of the enhancement layer after
+ * the start or a seek, with its random-access picture, would be dropped. The difference is
+ * learned (see CONFIRM) and the packets of the enhancement track pair by their decoding time less
+ * it; until it is learned, and in a stream whose layers are not in the same order, it is 0.
+ *
+ * A base packet waits for the enhancement packet of its decoding time and goes out alone when the
+ * enhancement layer has none for it:
+ * - the enhancement layer is already past it;
+ * - the enhancement layer is silent: no packet of it came while as many base packets came as
+ *   SetSilent() says (base packets then do not wait at all until it is back);
+ * - MAX_WAITING base packets wait;
+ * - the stream ended;
+ * - its time is not known.
+ * How far apart a multiplexer puts the two packets of an access unit is not known for real discs,
+ * hence no fixed short wait: while the enhancement layer keeps coming, a base packet waits for
+ * its own.
+ *
+ * The units of both tracks are framed as their container frames them: start codes (Annex B) in a
+ * transport stream; in MP4 and Matroska a length before each unit, with an hvcC record. A joined
+ * packet keeps the framing of the base track. No part of this depends on Kodi, so that the same
+ * file is tested outside of it.
+ */
+class CDVLayerMerge
+{
+public:
+  CDVLayerMerge() = default;
+  ~CDVLayerMerge();
+  CDVLayerMerge(const CDVLayerMerge&) = delete;
+  CDVLayerMerge& operator=(const CDVLayerMerge&) = delete;
+
+  //! \brief The containers whose two tracks are joined
+  enum class Container
+  {
+    NONE,
+    TRANSPORT_STREAM,
+    MP4,
+    MATROSKA,
+  };
+
+  //! \brief What Find() found
+  struct Layers
+  {
+    enum class Result
+    {
+      NONE, //!< no pair of tracks
+      JOINED, //!< a pair that is joined
+      FRAMING, //!< a pair whose units are not framed as its container frames them: not joined
+      WRONG_SIZE, //!< a pair whose second track has not the size of an enhancement layer
+    };
+    Result result = Result::NONE;
+    Container container = Container::NONE;
+    int base = -1; //!< stream index of the base layer of the pair (joined or not)
+    int enhancement = -1; //!< stream index of its enhancement layer
+    //! known by the Dolby Vision record of the enhancement track; else (a disc) by the stream
+    //! numbers that the Blu-ray format gives to the two layers
+    bool described = false;
+    AVRational rate{0, 1}; //!< frame rate of the base layer, 0 when not known
+    AVDOVIDecoderConfigurationRecord record{}; //!< of the one-track form, when joined
+    //! bytes of the length before each unit of each track; 0: start codes
+    int baseLengthSize = 0;
+    int enhancementLengthSize = 0;
+    //! the container gives the packets their decoding times (a transport stream, MP4); Matroska
+    //! does not
+    bool decodingTimes = true;
+    //! What the container says is enough. False: two Matroska tracks that libavformat does not
+    //! group (no record, or records that do not tell which is which); they are a pair only once
+    //! their packets show it (Verification()), and the record is made for that case.
+    bool verified = true;
+    //! when not joined: why, in words for the log (a static string; empty when the stream has no
+    //! second video track to speak of)
+    const char* reason = "";
+  };
+
+  /*!
+   * \brief Look for the two tracks in the stream groups that libavformat makes of them
+   *
+   * libavformat groups them by the Dolby Vision descriptor of the enhancement track of a
+   * transport stream, or by the stream numbers of a Blu-ray stream; by the 'vdep' reference of
+   * an MP4 enhancement track with its record, in a Dolby Vision sample entry or (Hades,
+   * ffmpeg-9930) in an HEVC one ('hvc1', 'hev1') with a reference to one track only; and in Matroska,
+   * which has no such reference, by the Dolby Vision record of the enhancement track when there
+   * is exactly one other HEVC track. For MP4 and Matroska the enhancement track must also have
+   * the size of an enhancement layer of the base track.
+   *
+   * Matroska files with the two tracks of a disc are not all made so: older ones have no record
+   * at all (the enhancement layer is found by its RPUs, which a muxer that did not read them did
+   * not see), or one that calls the enhancement layer profile 8 (a MEL, whose RPUs say that it
+   * carries no residual), or the same record on both tracks. Where libavformat makes no group of
+   * a Matroska file with exactly two HEVC tracks, one of the size of an enhancement layer of the
+   * other, and no record that speaks against it, the pair is found unverified (Layers::verified):
+   * it is one only if the first packets of the second track have an RPU, and the ones of the
+   * first track have none. (Hades) So is a Matroska group the wrong way round, whose
+   * "enhancement" track is the larger one: libavformat takes the track with the record as the
+   * enhancement layer, and some files have the record on the base track alone (a one-track
+   * Dolby Vision file with a second HEVC track is grouped alike, and its packets refuse it).
+   * \param program index of the program that plays; any other value: all streams play
+   */
+  static Layers Find(AVFormatContext* context, unsigned int program);
+
+  /*!
+   * \brief Hades: the line of the log for a pair of tracks whose second one has not the size of an
+   *        enhancement layer for the first (Layers::Result::WRONG_SIZE)
+   * \param base, enhancement the stream indexes of the pair as the container groups it
+   *
+   * The line said "the base layer plays alone" in every case. Two tracks of the same size (above
+   * 1920x1080: a pair of that size is joined) are two whole pictures, such as a file with a Dolby
+   * Vision video stream and an HDR10 or HDR10+ one of the same picture: neither is a base layer
+   * nor an enhancement layer, and each plays as a video stream of its own, as do two tracks of
+   * other sizes.
+   */
+  static std::string WrongSizeReason(
+      int base, int enhancement, int baseWidth, int baseHeight, int width, int height)
+  {
+    const std::string first = std::to_string(base);
+    const std::string second = std::to_string(enhancement);
+    if (baseWidth == width && baseHeight == height)
+      return "CDVDDemuxFFmpeg: streams " + first + " and " + second +
+             " are two video tracks of the same size (" + std::to_string(width) + "x" +
+             std::to_string(height) +
+             ") that the container groups as Dolby Vision: two whole pictures, not a base layer "
+             "and its enhancement layer. Not joined: each plays as a video stream of its own";
+    return "CDVDDemuxFFmpeg: the second HEVC track of this stream (stream " + second + ", " +
+           std::to_string(width) + "x" + std::to_string(height) +
+           ") does not have the size of a Dolby Vision enhancement layer for the base layer of "
+           "stream " +
+           first + " (" + std::to_string(baseWidth) + "x" + std::to_string(baseHeight) +
+           "): not joined, each plays as a video stream of its own";
+  }
+
+  /*!
+   * \brief The record of a stream that no Dolby Vision record declares, from what an access unit
+   *        of it says (dvbridge_rpu_probe_packet())
+   *
+   * Only what can be told for sure: profile 7 where the stream carries both layers (units of type
+   * 63) and its RPU is the one of profile 7; profile 5; profile 8 with a base layer of
+   * PQ and BT.2020 (compatibility 1), HLG (4) or SDR BT.709 (2). Nothing else: an RPU of a full
+   * enhancement layer without that layer in the stream (it is in another track, or missing),
+   * profile 4, or a base layer whose signal is not one of those.
+   * \param parameters of the stream: its size and colour
+   * \return false when the stream is not to be taken as Dolby Vision
+   */
+  struct RpuProbe
+  {
+    bool rpu = false;
+    bool layer = false;
+    unsigned int rpu_profile = 0;
+    unsigned int vdr_bit_depth = 0;
+    bool bl_full_range = false;
+    bool el_resampling = false;
+    bool residual_disabled = false;
+    unsigned int profile = 0;
+  };
+  static void ProbeRpu(const uint8_t* data, size_t size, int lengthSize, RpuProbe& out);
+
+  static bool RecordFromRpu(const RpuProbe& probe,
+                            const AVCodecParameters* parameters,
+                            AVRational rate,
+                            AVDOVIDecoderConfigurationRecord& record);
+
+  //! \brief What the packets of an unverified pair said (Layers::verified)
+  enum class Verification
+  {
+    VERIFIED, //!< a pair, or one whose container said so
+    PENDING, //!< not known yet: base packets wait, as they wait for their enhancement packets
+    REFUSED, //!< no pair: what waits goes out as it was read, then every packet as it is read
+  };
+  Verification GetVerification() const { return m_verification; }
+
+  //! \brief No packet waits (after a refusal, the join can be left)
+  bool Empty() const { return m_base.waiting.empty() && m_enhancement.waiting.empty(); }
+
+  //! packets of the second track that may come before one with an RPU, when a pair is verified
+  static constexpr unsigned int VERIFY_PACKETS = 4;
+
+  /*!
+   * \brief The framing of a track: the bytes of the length before each unit when its codec
+   *        parameters have an hvcC record, 0 for start codes. As libavcodec tells them apart: such
+   *        a record starts with its version, 1.
+   */
+  static int LengthSize(const AVCodecParameters* parameters);
+
+  /*!
+   * \brief Whether these bytes are an hvcC record that the decoder of the enhancement layer can
+   *        take as its configuration (the one of the enhancement track of a pair in MP4 or
+   *        Matroska, which may hold its parameter sets)
+   */
+  static bool IsConfigurationRecord(const uint8_t* data, int size);
+
+  //! \brief Take what Find() found of the pair that is read: its rate, framing and times
+  void Configure(const Layers& layers);
+
+  /*!
+   * \brief av_read_frame() with the two tracks joined
+   *
+   * The packets of the base track come with the enhancement layer of their access unit, the ones
+   * of the enhancement track do not come, all others come as they are. At the end of the input
+   * what waits comes first.
+   */
+  int Read(AVFormatContext* context, int base, int enhancement, AVPacket* packet);
+
+  struct Counts
+  {
+    uint64_t joined = 0; //!< base packets that went out with their enhancement layer
+    uint64_t alone = 0; //!< base packets that went out without one
+    uint64_t dropped = 0; //!< enhancement packets that belonged to no base packet
+    uint64_t malformed = 0; //!< enhancement packets that could not be read as units
+    uint64_t unusable = 0; //!< joined packets whose LAYER_TIME the reader could not use
+    size_t waited = 0; //!< the most base packets that waited when one was joined
+    size_t queued = 0; //!< the most enhancement packets that waited when one was joined
+    //! Hades: of dropped, those before the first access unit joined after the start or a seek
+    uint64_t droppedFirst = 0;
+    //! Hades: the decoding times of the enhancement track less those of the base track, in the
+    //! time base of the base track, as last learned (0: none, or not learned; see CONFIRM)
+    int64_t offset = 0;
+    uint64_t offsets = 0; //!< Hades: offsets learned that differ from the one before
+    //! Hades: random-access pictures of both layers presented at the same time, at another offset
+    //! than the one in use, whose access units after them were not presented at the same times:
+    //! nothing learned (layers coded in different orders)
+    uint64_t unconfirmed = 0;
+  };
+
+  /*!
+   * \brief Take a packet of the base layer, or of the enhancement layer
+   * \param packet moved from; blank afterwards
+   * \return false when there was no memory (the packet is then dropped)
+   */
+  bool PushBase(AVPacket* packet);
+  bool PushEnhancement(AVPacket* packet);
+
+  /*!
+   * \brief The next packet of the base layer, with the enhancement layer of its access unit
+   * \param packet a blank packet, filled
+   * \param end no more packets come: what waits goes out as it is
+   * \return false when more packets have to be read first
+   */
+  bool Pop(AVPacket* packet, bool end);
+
+  //! \brief Forget what waits (a seek, a flush)
+  void Clear();
+
+  //! \brief Clear(), and forget what the packets of an unverified pair said (another pair)
+  void Restart();
+
+  const Counts& GetCounts() const { return m_counts; }
+
+  /*!
+   * \brief The key, in the strings metadata of a joined packet, of the presentation time of its
+   *        enhancement access unit
+   *
+   * The value is "<difference to the presentation time of the packet> <numerator> <denominator>",
+   * the last two being the time base of the difference (as the join writes it, that of the base
+   * track). The pictures of the two layers of a packet are not always presented together, and
+   * with this the pairing of the decoded pictures does not have to work out from the picture
+   * orders which ones are. A difference, so that it stays right when the reader moves the times
+   * of the packets; where a reader does not move all of them alike, see CheckLayerTime(). A
+   * packet has none when one of the two times is not known, the time bases are not known, or
+   * the times are more than MAX_LAYER_APART seconds apart, which is no reordering but a damaged
+   * time. The same text as DVBRIDGE_FEL_LAYER_TIME of tools/dvbridge/dvbridge_fel.h.
+   */
+  static constexpr char LAYER_TIME[] = "dvbridge_layer_time";
+  static constexpr int MAX_LAYER_APART = 10;
+  //! The value of LAYER_TIME for an access unit that has a time which the reader cannot use
+  //! (DVBRIDGE_FEL_LAYER_TIME_UNUSABLE)
+  static constexpr char LAYER_TIME_UNUSABLE[] = "-";
+
+  //! \brief The time bases of the two tracks, for LAYER_TIME. Read() sets them.
+  void SetTimeBases(AVRational base, AVRational enhancement);
+
+  /*!
+   * \brief Whether LAYER_TIME of a packet holds for the times that the reader makes
+   * \param packet a packet of the base layer, as Read() gave it
+   * \param microseconds the time that the reader gives to a time of the base track
+   *
+   * The difference between two times of the stream is the difference between the two times of
+   * the reader only where the reader moves both alike. Kodi's demuxer takes the start time of
+   * the file off every time after it, makes 0 of a time up to half a second before it, and
+   * leaves an earlier one as it is: for a packet on one side of the start whose enhancement
+   * access unit is presented on the other, the difference names another picture. Such a packet
+   * gets the difference between the two times of the reader. When the access unit is
+   * presented where the reader makes one time of many (within that half second: pictures that
+   * lead the first random-access picture of a file that was cut), no time names its picture:
+   * the packet gets LAYER_TIME_UNUSABLE, and is counted.
+   * \return false when the packet got LAYER_TIME_UNUSABLE
+   */
+  bool CheckLayerTime(AVPacket* packet, const std::function<double(int64_t)>& microseconds);
+
+  static constexpr size_t MAX_WAITING = 240; //!< base packets that wait for their enhancement
+  static constexpr size_t MAX_QUEUED = 240; //!< enhancement packets kept
+  static constexpr unsigned int SILENT = 60; //!< base packets without any enhancement packet
+
+  /*!
+   * \brief For the times that are made from the presentation times (Matroska): how many
+   *        pictures of a track may precede a picture in decoding order and follow it in output
+   *        order, at most
+   *
+   * Each track presents one picture at each time. From a random-access picture of a track on,
+   * the n-th of the times that its packets present, in order, is therefore the same for the n-th
+   * access unit from there in both tracks, also where the base and the enhancement picture of an
+   * access unit are presented at different times; it is the time by which the two packets of that
+   * access unit pair. It is known once REORDER more packets of the track came. HEVC allows 15
+   * (sps_max_num_reorder_pics); one more changes nothing but how long a packet waits for its
+   * time. The packets of a track before its first random-access picture (after a seek) have no
+   * time of their own. For the enhancement track those are the access units just before its
+   * first random-access one, in order: they get the times of the base packets just before the
+   * base packet of that one, and with them the base pictures their RPUs, as in a transport stream
+   * (their pictures cannot be decoded, their RPUs are the metadata of the pictures). Base packets
+   * wait for that, but not for an enhancement layer that brought as many packets as SetSilent()
+   * says without a random-access picture (no layer starts that late).
+   */
+  static constexpr size_t REORDER = 16;
+
+  /*!
+   * \brief (Hades) For the times of a container that gives decoding times: how the difference
+   *        between the decoding times of the two tracks is learned
+   *
+   * At a base packet of a random-access picture, when the enhancement track has a packet of a
+   * random-access picture presented at the same time: that is the access unit of the base packet
+   * where the two layers have their pictures in the same order, and then so are the CONFIRM
+   * access units after it in each track, pairwise presented at the same times. Only then is the
+   * difference between the decoding times of the two packets taken (at most MAX_OFFSET seconds);
+   * the base packet waits for those packets where it is not the difference in use. Where the
+   * enhancement packet that it pairs with by the difference in use is no random-access one, the
+   * one of its picture may come later (an enhancement layer behind): the base packet waits for
+   * the enhancement packets of up to MAX_OFFSET seconds after it. Where the enhancement layer is
+   * ahead and the offset is not learned yet (its first random-access picture did not tell it, or
+   * it changed), the base packet before the random-access one has already taken the enhancement
+   * packet of its picture: so the enhancement packets that left the queue are kept in short
+   * (SEEN), and the picture and the access units after it are looked for there too. Two layers
+   * coded in different orders (the two-track test stream of Hades: the same decoding times, and
+   * random-access pictures of the two layers at other access units, one of them presented at the
+   * time of one of the other layer) give no run of times, and nothing is learned. The difference
+   * stays after a seek (Clear(); it is checked again at the next such picture) and goes with
+   * Restart().
+   */
+  static constexpr size_t CONFIRM = 4;
+  static constexpr int MAX_OFFSET = 1;
+  //! Hades: the enhancement packets that left the queue last that are kept for that (CONFIRM): a
+  //! second of them at 120 pictures a second, with CONFIRM more
+  static constexpr size_t SEEN = 256;
+
+  /*!
+   * \brief After how many base packets without any enhancement packet the enhancement layer is
+   *        silent
+   *
+   * It is how long the first base packets wait at the start when the stream has no enhancement
+   * packets at all (after that the layer counts as absent, and nothing waits until a packet of
+   * it comes), so it should stay well below what the player keeps queued.
+   * \param packets taken between SILENT and MAX_WAITING - 1
+   */
+  void SetSilent(unsigned int packets);
+
+  //! \brief SetSilent() for two and a half seconds of a base layer of this frame rate
+  void SetRate(AVRational rate);
+
+  /*!
+   * \brief Append the units of an enhancement-layer access unit to a base-layer packet
+   * \param baseLengthSize framing of the base packet, and of what is appended: the bytes of the
+   *        length before each unit, 0 for start codes
+   * \param enhancementLengthSize framing of the enhancement access unit
+   * \return false when the enhancement layer is not a sequence of units, has a unit of type 63
+   *         (no enhancement layer has one: such a track would be the one-track form itself), a
+   *         unit does not fit the length of the base framing, or there is no memory; the base
+   *         packet is then unchanged
+   */
+  static bool Append(AVPacket* base,
+                     const uint8_t* enhancement,
+                     size_t size,
+                     int baseLengthSize = 0,
+                     int enhancementLengthSize = 0);
+
+  /*!
+   * \brief The level of a Dolby Vision stream (Dolby Vision Profiles and Levels): the first one
+   *        whose pixel rate and width hold the stream
+   * \return 0 when the size or the rate is not known, or no level holds it
+   */
+  static uint8_t Level(int width, int height, AVRational rate);
+
+  /*!
+   * \brief Whether a track can be the profile 7 enhancement layer of a base layer, by its size
+   *
+   * It has a quarter of the picture of the base layer, or the same picture when the base layer
+   * is no larger than 1920x1080. A size that is not known does not speak against it.
+   */
+  static bool EnhancementSize(int baseWidth, int baseHeight, int width, int height);
+
+private:
+  //! A packet that waits, with the decoding time of its access unit
+  struct Waiting
+  {
+    AVPacket* packet = nullptr;
+    int64_t time = 0; //!< in the time base of the base track; AV_NOPTS_VALUE when not known
+    int64_t slack = 0; //!< 0 for a time of its own; half a duration for one that follows
+    bool pending = false; //!< its time is made from presentation times and not known yet
+    //! a packet of the enhancement track before its first random-access packet, where the times
+    //! are made from presentation times: its time comes from the base track (Backfill())
+    bool early = false;
+    //! Hades: its presentation time, in the time base of the base track (AV_NOPTS_VALUE when not
+    //! known), and for a base packet whether it was looked at for the offset (CONFIRM)
+    int64_t pts = AV_NOPTS_VALUE;
+    bool checked = false;
+    int random = -1; //!< Hades: it holds a random-access picture (1) or not (0); -1: not looked at
+  };
+
+  //! The packets of a track that wait, and what gives the next one its time when it has none
+  struct Track
+  {
+    std::deque<Waiting> waiting;
+    int64_t time = 0; //!< of the last packet read
+    int64_t duration = 0; //!< of the last packet read
+    bool known = false; //!< time and duration are of a packet read since the last Clear()
+    // times made from the presentation times (Matroska):
+    bool started = false; //!< a random-access packet of the track came since the last Clear()
+    unsigned int unstarted = 0; //!< packets of the track before that one
+    std::vector<int64_t> presented; //!< a heap (least first) of the times not given yet
+    int lengthSize = 0; //!< framing of the units of the track, to find a random-access picture
+  };
+
+  bool Queue(Track& track, AVPacket* packet, bool enhancement);
+  void Verify(const AVPacket* packet, bool enhancement);
+  bool PopRefused(AVPacket* packet);
+  bool Backfill();
+  void GiveTimes(Track& track, size_t keep);
+  int64_t ToBase(int64_t time) const;
+  void AttachLayerTime(AVPacket* base, int64_t enhancementPts) const;
+  static bool SetLayerTime(AVPacket* packet, const char* value);
+  static void Forget(Track& track);
+  static bool SameUnit(const Waiting& a, const Waiting& b);
+  static bool After(const Waiting& enhancement, const Waiting& base);
+  bool Passed() const;
+  static Waiting ShiftedBy(const Waiting& enhancement, int64_t offset);
+  Waiting Shifted(const Waiting& enhancement) const { return ShiftedBy(enhancement, m_offset); }
+  bool SamePresentation(int64_t base, int64_t enhancement) const;
+  static bool IsRandomAccess(Waiting& waiting, int lengthSize);
+  bool LearnOffset(bool end);
+  void Remember(Waiting& enhancement);
+
+  Track m_base;
+  Track m_enhancement;
+  AVRational m_timeBase{0, 1}; //!< of the base track; not known: no LAYER_TIME
+  AVRational m_enhancementTimeBase{0, 1};
+  unsigned int m_silentAfter = SILENT;
+  unsigned int m_silent = 0; //!< base packets since the last enhancement packet
+  bool m_absent = false; //!< the layer went silent without ever having had a packet
+  bool m_any = false; //!< an enhancement packet has come
+  bool m_end = false; //!< the input ended and what waits is going out
+  bool m_fromPresentation = false; //!< the times are made from presentation times (REORDER)
+  Verification m_verification = Verification::VERIFIED;
+  unsigned int m_verifyLayer = 0; //!< packets of the second track probed without an RPU
+  unsigned int m_verifyBase = 0; //!< packets of the first track probed without one
+  bool m_layerRpu = false; //!< a packet of the second track had the RPU of a dual-layer stream
+  bool m_verifyDone = false; //!< the packets said it (VERIFIED or REFUSED)
+  int64_t m_offset = 0; //!< Hades: see CONFIRM
+  //! Hades: an enhancement packet that left the queue (joined or dropped), as LearnOffset() looks
+  //! at it: oldest first, at most SEEN, none from before the last Clear()
+  struct Seen
+  {
+    int64_t time;
+    int64_t slack;
+    int64_t pts;
+    bool random;
+  };
+  std::deque<Seen> m_seen;
+  bool m_joinedSinceClear = false; //!< Hades: an access unit was joined since the last Clear()
+  Counts m_counts;
+};

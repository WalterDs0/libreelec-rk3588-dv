+#ifdef HAVE_PIDV
+// Dolby Vision profile 7 can come in two video tracks, which libavformat puts in a stream group:
+// the transport stream of a UHD Blu-ray, Matroska files that keep its two tracks, and MP4 files
+// with the dual-track carriage of Dolby's specification. Without this the player opens
+// the first one, the base layer, and plays HDR10. Called while the streams are made, when the
+// program that plays is known and before its streams are added.
+void CDVDDemuxFFmpeg::FindDVLayers()
+{
+  using Result = CDVLayerMerge::Layers::Result;
+  using Container = CDVLayerMerge::Container;
+  const CDVLayerMerge::Layers layers = CDVLayerMerge::Find(m_pFormatContext, m_program);
+
+  if (layers.result == Result::FRAMING)
+    CLog::Log(LOGINFO,
+              "CDVDDemuxFFmpeg: Dolby Vision profile 7 in two video tracks (streams {} and {}) "
+              "whose units are not framed as the container frames them (a length of {} and of {} "
+              "bytes before each unit, 0 for start codes; a transport stream has start codes, MP4 "
+              "and Matroska lengths): not joined, the base layer plays alone",
+              layers.base, layers.enhancement, layers.baseLengthSize,
+              layers.enhancementLengthSize);
+  else if (layers.result == Result::WRONG_SIZE)
+  {
+    // (Hades: two tracks of the same size are two whole pictures: CDVLayerMerge::WrongSizeReason())
+    const AVCodecParameters* b = m_pFormatContext->streams[layers.base]->codecpar;
+    const AVCodecParameters* e = m_pFormatContext->streams[layers.enhancement]->codecpar;
+    CLog::Log(LOGINFO, "{}",
+              CDVLayerMerge::WrongSizeReason(layers.base, layers.enhancement, b->width, b->height,
+                                             e->width, e->height));
+  }
+  else if (layers.result == Result::NONE)
+    LogDVNotJoined(layers.reason);
+
+  const bool joined = layers.result == Result::JOINED;
+  const int base = joined ? layers.base : -1;
+  const int enhancement = joined ? layers.enhancement : -1;
+
+  // the same pair as before (the streams are made again, a program change): what waits stays
+  if (base == m_dvBaseIndex && enhancement == m_dvEnhancementIndex)
+  {
+    if (joined)
+    {
+      // more may be known of it by now (the size, the frame rate)
+      m_dvRecord = layers.record;
+      m_dvMerge.Configure(layers);
+    }
+    return;
+  }
+
+  ReportDVLayers();
+  m_dvMerge.Restart();
+  m_dvOffsetLines = 0;
+  m_dvBaseIndex = base;
+  m_dvEnhancementIndex = enhancement;
+  m_dvRecord = layers.record;
+  m_dvVerified = !joined || layers.verified;
+  if (!joined)
+    return;
+
+  m_dvMerge.Configure(layers);
+  if (!layers.verified)
+  {
+    CLog::Log(LOGINFO,
+              "CDVDDemuxFFmpeg: two HEVC tracks of Matroska that nothing groups, stream {} of "
+              "the size of a Dolby Vision enhancement layer for stream {} ({}): a Dolby Vision "
+              "pair only if the first packets of stream {} have an RPU and the ones of stream {} "
+              "none",
+              enhancement, base,
+              layers.described ? "a Dolby Vision record on the second one only"
+                               : "no Dolby Vision record",
+              enhancement, base);
+    return;
+  }
+  const char* how = "a Blu-ray stream, by its stream numbers";
+  if (layers.container == Container::MP4)
+    how = "MP4, by the reference and the Dolby Vision record of the enhancement track; units "
+          "with their lengths";
+  else if (layers.container == Container::MATROSKA)
+    how = "Matroska, by the Dolby Vision record of the enhancement track; units with their "
+          "lengths, decoding times made from the presentation times";
+  else if (layers.described)
+    how = "Dolby Vision descriptor";
+  CLog::Log(LOGINFO,
+            "CDVDDemuxFFmpeg: Dolby Vision profile 7 in two video tracks ({}): the enhancement "
+            "layer and the RPU of stream {} are joined to the base layer of stream {}",
+            how, enhancement, base);
+}
+
+// After the streams are made: the enhancement layer is no stream of the player, but its packets
+// are needed.
+void CDVDDemuxFFmpeg::KeepDVLayers()
+{
+  if (m_dvBaseIndex < 0)
+    return;
+
+  if (!GetStream(m_dvBaseIndex))
+  {
+    // the base layer did not become a stream of the player
+    m_dvMerge.Clear();
+    m_dvBaseIndex = -1;
+    m_dvEnhancementIndex = -1;
+    return;
+  }
+  m_pFormatContext->streams[m_dvEnhancementIndex]->discard = AVDISCARD_NONE;
+}
+
+void CDVDDemuxFFmpeg::CheckDVLayers()
+{
+  using Verification = CDVLayerMerge::Verification;
+  if (m_dvBaseIndex < 0 || m_dvVerified)
+    return;
+
+  const Verification verification = m_dvMerge.GetVerification();
+  if (verification == Verification::VERIFIED)
+  {
+    m_dvVerified = true;
+    CLog::Log(LOGINFO,
+              "CDVDDemuxFFmpeg: stream {} has the RPUs of a Dolby Vision enhancement layer and "
+              "stream {} none: they are a pair, and stream {} is Dolby Vision profile 7 from "
+              "here on",
+              m_dvEnhancementIndex, m_dvBaseIndex, m_dvBaseIndex);
+    if (CDemuxStream* stream = GetStream(m_dvBaseIndex))
+      PromoteDolbyVision(stream, m_dvRecord,
+                         m_pFormatContext->streams[m_dvEnhancementIndex]->codecpar);
+  }
+  else if (verification == Verification::REFUSED)
+  {
+    if (m_dvEnhancementIndex >= 0)
+      CLog::Log(LOGINFO,
+                "CDVDDemuxFFmpeg: streams {} and {} are no Dolby Vision pair (no RPU in the "
+                "first packets of the second, or one in those of the first): two streams, as "
+                "they were",
+                m_dvBaseIndex, m_dvEnhancementIndex);
+    // the second track becomes a stream with its next packet (AddStream())
+    m_dvEnhancementIndex = -1;
+    // what waited goes out first
+    if (m_dvMerge.Empty())
+      m_dvBaseIndex = -1;
+  }
+}
+
+void CDVDDemuxFFmpeg::PromoteDolbyVision(CDemuxStream* stream,
+                                        const AVDOVIDecoderConfigurationRecord& record,
+                                        const AVCodecParameters* enhancement)
+{
+  auto* video = dynamic_cast<CDemuxStreamVideo*>(stream);
+  if (!video)
+    return;
+  video->hdr_type = StreamHdrType::HDR_TYPE_DOLBYVISION;
+  video->dovi = record;
+  (void)enhancement;
+  // VideoPlayer opens the codec of the stream again with what it is now (CheckStreamChanges())
+  video->changes++;
+}
+
+void CDVDDemuxFFmpeg::LogDVNotJoined(const char* reason)
+{
+  if (!reason || !*reason)
+    return;
+  unsigned int hevc = 0;
+  for (unsigned int i = 0; i < m_pFormatContext->nb_streams; ++i)
+  {
+    const AVCodecParameters* par = m_pFormatContext->streams[i]->codecpar;
+    hevc += par->codec_type == AVMEDIA_TYPE_VIDEO && par->codec_id == AV_CODEC_ID_HEVC &&
+            !(m_pFormatContext->streams[i]->disposition & AV_DISPOSITION_ATTACHED_PIC);
+  }
+  bool group = false;
+  for (unsigned int i = 0; i < m_pFormatContext->nb_stream_groups; ++i)
+    group |= m_pFormatContext->stream_groups[i] &&
+             m_pFormatContext->stream_groups[i]->type == AV_STREAM_GROUP_PARAMS_DOLBY_VISION;
+  if (hevc < 2 && !group)
+    return;
+
+  // each track that may be a layer: HEVC video, one with a Dolby Vision record, one of a group
+  const bool ts = strcmp(m_pFormatContext->iformat->name, "mpegts") == 0;
+  std::string tracks;
+  for (unsigned int i = 0; i < m_pFormatContext->nb_streams; ++i)
+  {
+    const AVStream* st = m_pFormatContext->streams[i];
+    const AVCodecParameters* par = st->codecpar;
+    const AVPacketSideData* sd =
+        av_packet_side_data_get(par->coded_side_data, par->nb_coded_side_data,
+                                AV_PKT_DATA_DOVI_CONF);
+    const auto* record = sd && sd->size >= sizeof(AVDOVIDecoderConfigurationRecord)
+                             ? reinterpret_cast<const AVDOVIDecoderConfigurationRecord*>(sd->data)
+                             : nullptr;
+    bool inGroup = false;
+    for (unsigned int g = 0; g < m_pFormatContext->nb_stream_groups; ++g)
+    {
+      const AVStreamGroup* sg = m_pFormatContext->stream_groups[g];
+      if (sg && sg->type == AV_STREAM_GROUP_PARAMS_DOLBY_VISION)
+        for (unsigned int j = 0; j < sg->nb_streams; ++j)
+          inGroup |= sg->streams[j] == st;
+    }
+    const bool video = par->codec_type == AVMEDIA_TYPE_VIDEO && par->codec_id == AV_CODEC_ID_HEVC;
+    if (!video && !record && !inGroup)
+      continue;
+    char tag[AV_FOURCC_MAX_STRING_SIZE] = {};
+    av_fourcc_make_string(tag, par->codec_tag);
+    const int lengthSize = CDVLayerMerge::LengthSize(par);
+    std::string line = StringUtils::Format(
+        "{}stream {} ({} {}): {} {}, {}x{}, tag {}, {}", tracks.empty() ? "" : "; ", i,
+        ts ? "PID" : "track", ts ? StringUtils::Format("0x{:x}", st->id) : std::to_string(st->id),
+        av_get_media_type_string(par->codec_type) ? av_get_media_type_string(par->codec_type)
+                                                  : "unknown",
+        avcodec_get_name(par->codec_id), par->width, par->height, tag,
+        lengthSize ? StringUtils::Format("units with {}-byte lengths", lengthSize)
+                   : std::string("start codes"));
+    if (record)
+      line += StringUtils::Format(", Dolby Vision record: profile {} level {}, RPU {}, enhancement "
+                                  "layer {}, base layer {}, compatibility {}",
+                                  record->dv_profile, record->dv_level, record->rpu_present_flag,
+                                  record->el_present_flag, record->bl_present_flag,
+                                  record->dv_bl_signal_compatibility_id);
+    else
+      line += ", no Dolby Vision record";
+    if (inGroup)
+      line += ", in a Dolby Vision group of libavformat";
+    if (st->disposition & AV_DISPOSITION_ATTACHED_PIC)
+      line += ", an attached picture";
+    tracks += line;
+  }
+  const std::string message = StringUtils::Format(
+      "CDVDDemuxFFmpeg: video tracks not joined as Dolby Vision in two tracks ({}): {}", reason,
+      tracks);
+  if (message == m_dvNotJoined)
+    return;
+  m_dvNotJoined = message;
+  CLog::Log(LOGINFO, "{}", message);
+}
+
+// A HEVC stream that no Dolby Vision record declares, and whose first packets bring an RPU: the
+// RPU says what it is (CDVLayerMerge::RecordFromRpu()), and only what can be told for sure makes
+// it Dolby Vision. A stream without one stays as it is: nothing of it changes.
+void CDVDDemuxFFmpeg::ProbeDolbyVision(CDemuxStream* stream,
+                                       int streamIdx,
+                                       const uint8_t* data,
+                                       int size)
+{
+  // the packets of a stream that are looked at
+  static constexpr unsigned int PROBED_PACKETS = 48;
+
+  if (!stream || stream->type != StreamType::VIDEO || stream->codec != AV_CODEC_ID_HEVC ||
+      streamIdx == m_dvBaseIndex || streamIdx == m_dvEnhancementIndex || !data || size <= 0)
+    return;
+  unsigned int& probed = m_dvProbed[streamIdx];
+  if (probed >= PROBED_PACKETS)
+    return;
+  auto* video = static_cast<CDemuxStreamVideo*>(stream);
+  if (video->hdr_type == StreamHdrType::HDR_TYPE_DOLBYVISION || video->dovi.dv_profile)
+  {
+    probed = PROBED_PACKETS;
+    return;
+  }
+  ++probed;
+
+  const AVStream* avStream = m_pFormatContext->streams[streamIdx];
+  CDVLayerMerge::RpuProbe probe;
+  CDVLayerMerge::ProbeRpu(data, static_cast<size_t>(size),
+                            CDVLayerMerge::LengthSize(avStream->codecpar), probe);
+  if (!probe.rpu)
+    return;
+  probed = PROBED_PACKETS;
+
+  AVRational rate = av_guess_frame_rate(m_pFormatContext, const_cast<AVStream*>(avStream), nullptr);
+  AVDOVIDecoderConfigurationRecord record{};
+  if (!CDVLayerMerge::RecordFromRpu(probe, avStream->codecpar, rate, record))
+  {
+    CLog::Log(LOGINFO,
+              "CDVDDemuxFFmpeg: stream {} has Dolby Vision RPUs but no Dolby Vision record, and "
+              "they do not say for sure what it is (RPU profile {}, {} enhancement layer, a "
+              "guess of profile {}): it plays as it is",
+              streamIdx, probe.rpu_profile, probe.layer ? "with an" : "no", probe.profile);
+    return;
+  }
+  CLog::Log(LOGINFO,
+            "CDVDDemuxFFmpeg: stream {} has Dolby Vision RPUs but no Dolby Vision record: it is "
+            "Dolby Vision profile {} ({} enhancement layer, base layer compatibility {}) from "
+            "here on",
+            streamIdx, record.dv_profile, record.el_present_flag ? "with an" : "no",
+            record.dv_bl_signal_compatibility_id);
+  m_dvPromoted[streamIdx] = record;
+  PromoteDolbyVision(stream, record, nullptr);
+}
+
+void CDVDDemuxFFmpeg::ReportDVLayers()
+{
+  const CDVLayerMerge::Counts& counts = m_dvMerge.GetCounts();
+  if (counts.joined + counts.alone == m_dvReported)
+    return;
+
+  m_dvReported = counts.joined + counts.alone;
+  // (Hades: the offset of the decoding times of the two tracks, where one was learned or tried)
+  std::string offset;
+  if ((counts.offsets || counts.unconfirmed) && m_pFormatContext && m_dvBaseIndex >= 0 &&
+      static_cast<unsigned int>(m_dvBaseIndex) < m_pFormatContext->nb_streams)
+    offset = StringUtils::Format(
+        "; the decoding times of the enhancement track are paired {:.3f} ms off those of the base "
+        "track ({} offsets learned; {} random-access pictures of both layers at the same time "
+        "were followed by pictures in another order, and taught nothing)",
+        counts.offset * av_q2d(m_pFormatContext->streams[m_dvBaseIndex]->time_base) * 1000,
+        counts.offsets, counts.unconfirmed);
+  CLog::Log(LOGINFO,
+            "CDVDDemuxFFmpeg: Dolby Vision in two tracks so far: {} access units joined and {} "
+            "without their enhancement layer; {} enhancement packets had no base packet ({} of "
+            "them before the first access unit joined after the start or a seek) and {} were not "
+            "unit streams; at most {} base and {} enhancement packets waited for the other layer; "
+            "the time of {} enhancement access units could not be used (they are presented "
+            "before the start time of the file){}",
+            counts.joined, counts.alone, counts.dropped, counts.droppedFirst, counts.malformed,
+            counts.waited, counts.queued, counts.unusable, offset);
+}
+
+void CDVDDemuxFFmpeg::TellDVOffset()
+{
+  const CDVLayerMerge::Counts& counts = m_dvMerge.GetCounts();
+  m_dvOffsetsTold = counts.offsets;
+  if (m_dvOffsetLines >= 4 || (counts.offset == 0 && m_dvOffsetLines == 0) ||
+      m_dvBaseIndex < 0 || static_cast<unsigned int>(m_dvBaseIndex) >= m_pFormatContext->nb_streams)
+    return;
+  ++m_dvOffsetLines;
+  const double ms =
+      counts.offset * av_q2d(m_pFormatContext->streams[m_dvBaseIndex]->time_base) * 1000;
+  CLog::Log(LOGINFO,
+            "CDVDDemuxFFmpeg: Dolby Vision in two tracks: the decoding times of the enhancement "
+            "track (stream {}) are {:.3f} ms {} those of the base track (stream {}), with the "
+            "same pictures in the same order (a random-access picture of both layers presented "
+            "at the same time, and the {} access units after it): its packets pair by their "
+            "decoding time less that{}",
+            m_dvEnhancementIndex, ms < 0 ? -ms : ms, ms < 0 ? "before" : "after", m_dvBaseIndex,
+            CDVLayerMerge::CONFIRM, m_dvOffsetLines == 4 ? " (not told again for this pair)" : "");
+}
+#endif
+
+int CDVDDemuxFFmpeg::ReadFrame(AVPacket* packet)
+{
+#ifdef HAVE_PIDV
+  if (m_dvBaseIndex >= 0)
+  {
+    // access units after which the log gets its first line about the join
+    static constexpr uint64_t FIRST_REPORT = 600;
+
+    const int result =
+        m_dvMerge.Read(m_pFormatContext, m_dvBaseIndex, m_dvEnhancementIndex, packet);
+    const CDVLayerMerge::Counts& counts = m_dvMerge.GetCounts();
+    if (!m_dvReported && counts.joined + counts.alone >= FIRST_REPORT)
+      ReportDVLayers();
+    if (counts.offsets != m_dvOffsetsTold)
+      TellDVOffset();
+    CheckDVLayers();
+    return result;
+  }
+#endif
+  return av_read_frame(m_pFormatContext, packet);
+}

+bool CDVDDemuxFFmpeg::ProbeHdrVivid(CDemuxStream* stream,
+                                    int streamIdx,
+                                    const uint8_t* data,
+                                    int size,
+                                    unsigned int& probed,
+                                    unsigned int done)
+{
+  if (m_dvFromHdrVivid.count(streamIdx))
+    return true;
+  const auto settings = CServiceBroker::GetSettingsComponent()->GetSettings();
+  if (!settings || !settings->GetBool(CSettings::SETTING_VIDEOPLAYER_DOLBYVISIONFROMHDRVIVID))
+    return false;
+  const AVStream* avStream = m_pFormatContext->streams[streamIdx];
+  const CDVHdrVivid::AccessUnit unit =
+      CDVHdrVivid::Read(data, static_cast<size_t>(size), CDVLayerMerge::LengthSize(avStream->codecpar));
+  if (unit.t35.empty())
+    return false;
+
+  const CDVHdrVivid::Verdict verdict = CDVHdrVivid::Judge(unit, avStream->codecpar);
+  if (verdict != CDVHdrVivid::Verdict::HDR_VIVID)
+  {
+    if (verdict != CDVHdrVivid::Verdict::NOT_YET || probed >= done)
+    {
+      probed = done;
+      CLog::Log(LOGDEBUG, "CDVDDemuxFFmpeg: stream {} has HDR Vivid metadata; not as Dolby Vision: {}",
+                streamIdx, CDVHdrVivid::Why(unit, avStream->codecpar));
+    }
+    return true;
+  }
+  probed = done;
+
+  AVDOVIDecoderConfigurationRecord record{};
+  const AVRational rate =
+      av_guess_frame_rate(m_pFormatContext, const_cast<AVStream*>(avStream), nullptr);
+  if (!CDVHdrVivid::Record(avStream->codecpar, rate, record))
+    return true;
+
+  CLog::Log(LOGINFO,
+            "CDVDDemuxFFmpeg: stream {} is HDR Vivid without Dolby Vision: promoting to Dolby Vision profile 8.1",
+            streamIdx);
+  auto* video = static_cast<CDemuxStreamVideo*>(stream);
+  m_dvPromoted[streamIdx] = record;
+  m_dvFromHdrVivid[streamIdx] = true;
+  video->doviFromHdrVivid = true;
+  PromoteDolbyVision(stream, record, nullptr);
+  return true;
+}

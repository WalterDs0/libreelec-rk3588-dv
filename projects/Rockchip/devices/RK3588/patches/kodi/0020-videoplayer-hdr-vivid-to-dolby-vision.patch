diff --git a/xbmc/cores/VideoPlayer/DVDDemuxers/HDRVividDovi.c b/xbmc/cores/VideoPlayer/DVDDemuxers/HDRVividDovi.c
new file mode 100644
--- /dev/null
+++ b/xbmc/cores/VideoPlayer/DVDDemuxers/HDRVividDovi.c
@@ -0,0 +1,287 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of Kodi - https://kodi.tv
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+#include "HDRVividDovi.h"
+
+#include <math.h>
+#include <string.h>
+
+#include <libavutil/mem.h>
+#include <libavutil/rational.h>
+
+#define PQ_M1 (2610.0 / 16384.0)
+#define PQ_M2 (2523.0 / 4096.0 * 128.0)
+#define PQ_C1 (3424.0 / 4096.0)
+#define PQ_C2 (2413.0 / 4096.0 * 32.0)
+#define PQ_C3 (2392.0 / 4096.0 * 32.0)
+
+static double pq_from_linear(double y)
+{
+  y = y < 0 ? 0 : y > 1 ? 1 : y;
+  const double p = pow(y, PQ_M1);
+  return pow((PQ_C1 + PQ_C2 * p) / (1 + PQ_C3 * p), PQ_M2);
+}
+
+static unsigned code12(double e)
+{
+  const double c = floor(e * 4095 + 0.5);
+  return c < 0 ? 0 : c > 4095 ? 4095 : (unsigned)c;
+}
+
+static AVDOVIMetadata *make_profile81_metadata(unsigned min_pq, unsigned max_pq, unsigned avg_pq,
+                                               const AVMasteringDisplayMetadata *mastering,
+                                               const AVContentLightMetadata *light,
+                                               bool scene_refresh, size_t *size)
+{
+  if (!mastering || !mastering->has_luminance || !size || mastering->max_luminance.den <= 0 ||
+      mastering->min_luminance.den <= 0)
+    return NULL;
+  const double max_nits = av_q2d(mastering->max_luminance);
+  const double min_nits = av_q2d(mastering->min_luminance);
+  if (!(max_nits > 0 && max_nits <= 10000 && min_nits >= 0 && min_nits < max_nits))
+    return NULL;
+  AVDOVIMetadata *m = av_dovi_metadata_alloc(size);
+  if (!m)
+    return NULL;
+
+  AVDOVIRpuDataHeader *h = av_dovi_get_header(m);
+  h->rpu_type = 2;
+  h->rpu_format = 18;
+  h->vdr_rpu_profile = 1;
+  h->vdr_rpu_level = 0;
+  h->coef_data_type = 0;
+  h->coef_log2_denom = 23;
+  h->vdr_rpu_normalized_idc = 1;
+  h->bl_video_full_range_flag = 0;
+  h->bl_bit_depth = 10;
+  h->el_bit_depth = 10;
+  h->vdr_bit_depth = 12;
+  h->spatial_resampling_filter_flag = 0;
+  h->el_spatial_resampling_filter_flag = 0;
+  h->disable_residual_flag = 1;
+
+  AVDOVIDataMapping *map = av_dovi_get_mapping(m);
+  map->vdr_rpu_id = 0;
+  map->mapping_color_space = 0;
+  map->mapping_chroma_format_idc = 0;
+  for (int c = 0; c < 3; ++c) {
+    AVDOVIReshapingCurve *curve = &map->curves[c];
+    curve->num_pivots = 2;
+    curve->pivots[0] = 0;
+    curve->pivots[1] = 1023;
+    curve->mapping_idc[0] = AV_DOVI_MAPPING_POLYNOMIAL;
+    curve->poly_order[0] = 1;
+    curve->poly_coef[0][0] = 0;
+    curve->poly_coef[0][1] = 1 << 23;
+    curve->poly_coef[0][2] = 0;
+  }
+  map->nlq_method_idc = AV_DOVI_NLQ_NONE;
+  map->num_x_partitions = 1;
+  map->num_y_partitions = 1;
+
+  AVDOVIColorMetadata *col = av_dovi_get_color(m);
+  static const int ycc[9] = {9574, 0, 13802, 9574, -1540, -5348, 9574, 17610, 0};
+  static const int lms[9] = {7222, 8771, 390, 2654, 12430, 1300, 0, 422, 15962};
+  for (int i = 0; i < 9; ++i) {
+    col->ycc_to_rgb_matrix[i] = (AVRational){ycc[i], 8192};
+    col->rgb_to_lms_matrix[i] = (AVRational){lms[i], 16384};
+  }
+  col->ycc_to_rgb_offset[0] = (AVRational){16777216, 1 << 28};
+  col->ycc_to_rgb_offset[1] = (AVRational){134217728, 1 << 28};
+  col->ycc_to_rgb_offset[2] = (AVRational){134217728, 1 << 28};
+  col->dm_metadata_id = 0;
+  col->scene_refresh_flag = scene_refresh;
+  col->signal_eotf = 65535;
+  col->signal_bit_depth = 12;
+  col->signal_color_space = 0;
+  col->signal_chroma_format = 0;
+  col->signal_full_range_flag = 1;
+  col->source_min_pq = min_nits <= 0.001 ? 7 : code12(pq_from_linear(min_nits / 10000));
+  col->source_max_pq = code12(pq_from_linear(max_nits / 10000));
+  col->source_diagonal = 42;
+
+  m->num_ext_blocks = 0;
+  AVDOVIDmData *e = av_dovi_get_ext(m, m->num_ext_blocks++);
+  e->level = 1;
+  e->l1.min_pq = (uint16_t)min_pq;
+  e->l1.max_pq = (uint16_t)max_pq;
+  e->l1.avg_pq = (uint16_t)avg_pq;
+  e = av_dovi_get_ext(m, m->num_ext_blocks++);
+  e->level = 6;
+  e->l6.max_luminance = (uint16_t)floor(max_nits + 0.5);
+  e->l6.min_luminance = (uint16_t)floor(min_nits * 10000 + 0.5);
+  e->l6.max_cll = light ? (uint16_t)(light->MaxCLL > 65535 ? 65535 : light->MaxCLL) : 0;
+  e->l6.max_fall = light ? (uint16_t)(light->MaxFALL > 65535 ? 65535 : light->MaxFALL) : 0;
+  return m;
+}
+
+bool hdrvivid_dovi_level1(const AVDynamicHDRVivid *m, struct hdrvivid_dovi_l1 *l1)
+{
+  if (!m || !l1 || m->num_windows < 1)
+    return false;
+  if (m->system_start_code < 1 || m->system_start_code > 7)
+    return false;
+
+  memset(l1, 0, sizeof(*l1));
+  const AVHDRVividColorTransformParams *w = &m->params[0];
+
+  if (w->minimum_maxrgb.den <= 0 || w->average_maxrgb.den <= 0 || w->maximum_maxrgb.den <= 0)
+    return false;
+
+  const unsigned min_raw = (unsigned)w->minimum_maxrgb.num;
+  const unsigned avg_raw = (unsigned)w->average_maxrgb.num;
+  const unsigned max_raw = (unsigned)w->maximum_maxrgb.num;
+
+  if (min_raw > avg_raw || avg_raw > max_raw || max_raw > 4095)
+    return false;
+
+  l1->min_raw = min_raw;
+  l1->avg_raw = avg_raw;
+  l1->max_raw = max_raw;
+
+  l1->min_pq = min_raw <= 12 ? min_raw : 12;
+  l1->max_pq = max_raw < 2081 ? 2081 : max_raw;
+  l1->avg_pq = avg_raw < 819 ? 819 : avg_raw;
+  if (l1->avg_pq > l1->max_pq - 1)
+    l1->avg_pq = l1->max_pq - 1;
+  if (l1->min_pq > l1->avg_pq)
+    l1->min_pq = l1->avg_pq;
+
+  return true;
+}
+
+bool hdrvivid_dovi_level1_from_t35(const uint8_t *t35, size_t size, struct hdrvivid_dovi_l1 *l1)
+{
+  if (!t35 || size < 12 || !l1)
+    return false;
+  if (t35[0] != 0x26 || t35[1] != 0x00 || t35[2] != 0x04 || t35[3] != 0x00 || t35[4] != 0x05)
+    return false;
+  const uint8_t start_code = t35[5];
+  if (start_code < 1 || start_code > 7)
+    return false;
+
+  const unsigned min_raw = ((unsigned)t35[6] << 4) | ((unsigned)t35[7] >> 4);
+  const unsigned avg_raw = (((unsigned)t35[7] & 0x0F) << 8) | (unsigned)t35[8];
+  const unsigned max_raw = (((unsigned)t35[10] & 0x0F) << 8) | (unsigned)t35[11];
+
+  if (min_raw > avg_raw || avg_raw > max_raw || max_raw > 4095)
+    return false;
+
+  l1->min_raw = min_raw;
+  l1->avg_raw = avg_raw;
+  l1->max_raw = max_raw;
+
+  l1->min_pq = min_raw <= 12 ? min_raw : 12;
+  l1->max_pq = max_raw < 2081 ? 2081 : max_raw;
+  l1->avg_pq = avg_raw < 819 ? 819 : avg_raw;
+  if (l1->avg_pq > l1->max_pq - 1)
+    l1->avg_pq = l1->max_pq - 1;
+  if (l1->min_pq > l1->avg_pq)
+    l1->min_pq = l1->avg_pq;
+
+  return true;
+}
+
+bool hdrvivid_dovi_same_scene(const AVDynamicHDRVivid *a, const AVDynamicHDRVivid *b)
+{
+  if (!a || !b || a->system_start_code != b->system_start_code || a->num_windows != b->num_windows)
+    return false;
+  const int windows = a->num_windows < 1 ? 1 : a->num_windows > 3 ? 3 : a->num_windows;
+  for (int i = 0; i < windows; ++i) {
+    const AVHDRVividColorTransformParams *p = &a->params[i], *q = &b->params[i];
+    if (p->minimum_maxrgb.num != q->minimum_maxrgb.num ||
+        p->average_maxrgb.num != q->average_maxrgb.num ||
+        p->maximum_maxrgb.num != q->maximum_maxrgb.num ||
+        p->tone_mapping_mode_flag != q->tone_mapping_mode_flag)
+      return false;
+  }
+  return true;
+}
+
+struct hdrvivid_dovi_scene *hdrvivid_dovi_scene_create(void)
+{
+  return av_mallocz(sizeof(struct hdrvivid_dovi_scene));
+}
+
+void hdrvivid_dovi_scene_reset(struct hdrvivid_dovi_scene *s)
+{
+  if (!s)
+    return;
+  av_freep(&s->first);
+  av_freep(&s->made);
+  memset(s, 0, sizeof(*s));
+}
+
+void hdrvivid_dovi_scene_destroy(struct hdrvivid_dovi_scene *s)
+{
+  hdrvivid_dovi_scene_reset(s);
+  av_free(s);
+}
+
+const AVDOVIMetadata *hdrvivid_dovi_next(struct hdrvivid_dovi_scene *s,
+                                         const AVDynamicHDRVivid *vivid,
+                                         const uint8_t *t35, size_t t35_size,
+                                         const AVMasteringDisplayMetadata *mastering,
+                                         const AVContentLightMetadata *light,
+                                         size_t *size, bool *repeated)
+{
+  if (!s || !size || !repeated)
+    return NULL;
+  *repeated = false;
+
+  struct hdrvivid_dovi_l1 l1;
+  bool has_l1 = false;
+  if (vivid)
+    has_l1 = hdrvivid_dovi_level1(vivid, &l1);
+  else if (t35 && t35_size >= 12)
+    has_l1 = hdrvivid_dovi_level1_from_t35(t35, t35_size, &l1);
+
+  if (has_l1) {
+    if (s->made && s->have_from && vivid && hdrvivid_dovi_same_scene(&s->from, vivid)) {
+      *size = s->size;
+      return s->made;
+    }
+
+    AVMasteringDisplayMetadata default_mastering;
+    if (!mastering || !mastering->has_luminance) {
+      memset(&default_mastering, 0, sizeof(default_mastering));
+      default_mastering.has_luminance = 1;
+      default_mastering.max_luminance = (AVRational){4000, 1};
+      default_mastering.min_luminance = (AVRational){1, 10000};
+      mastering = &default_mastering;
+    }
+
+    size_t bytes = 0;
+    AVDOVIMetadata *first = make_profile81_metadata(l1.min_pq, l1.max_pq, l1.avg_pq,
+                                                    mastering, light, true, &bytes);
+    AVDOVIMetadata *made = first ? av_malloc(bytes) : NULL;
+    if (made) {
+      memcpy(made, first, bytes);
+      av_dovi_get_color(made)->scene_refresh_flag = 0;
+      av_free(s->first);
+      av_free(s->made);
+      s->first = first;
+      s->made = made;
+      s->size = bytes;
+      if (vivid) {
+        s->from = *vivid;
+        s->have_from = true;
+      } else {
+        s->have_from = false;
+      }
+      *size = bytes;
+      return s->first;
+    }
+    av_free(first);
+  }
+
+  if (!s->made)
+    return NULL;
+  *repeated = true;
+  *size = s->size;
+  return s->made;
+}

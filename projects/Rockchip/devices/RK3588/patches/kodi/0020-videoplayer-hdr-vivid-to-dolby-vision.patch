diff --git a/xbmc/cores/VideoPlayer/DVDDemuxers/DVHdrVivid.cpp b/xbmc/cores/VideoPlayer/DVDDemuxers/DVHdrVivid.cpp
new file mode 100644
--- /dev/null
+++ b/xbmc/cores/VideoPlayer/DVDDemuxers/DVHdrVivid.cpp
@@ -0,0 +1,155 @@
+/*
+ *  Copyright (C) 2026 Hades
+ *  This file is part of Kodi - https://kodi.tv
+ *
+ *  SPDX-License-Identifier: GPL-2.0-or-later
+ *  See LICENSES/README.md for more information.
+ */
+
+#include "DVHdrVivid.h"
+
+#include "DVLayerMerge.h"
+#include "HDRVividDovi.h"
+#include "utils/HevcSei.h"
+
+namespace
+{
+void TakeUnit(const uint8_t* unit, size_t size, CDVHdrVivid::AccessUnit* au)
+{
+  if (size < 2 || (unit[0] & 0x80))
+    return;
+  const unsigned int type = (unit[0] >> 1) & 0x3f;
+  const unsigned int layer = ((unit[0] & 1) << 5) | (unit[1] >> 3);
+  if (type == 62 || type == 63)
+    au->dolbyVision = true;
+  else if (type < 32 && layer == 0)
+    au->picture = true;
+  else if (type == 39 && layer == 0 && size > 2)
+  {
+    std::vector<uint8_t> buf;
+    const std::vector<CHevcSei> messages = CHevcSei::ParseSeiRbspUnclearedEmulation(unit, size, buf);
+    for (const CHevcSei& sei : messages)
+      if (sei.m_payloadType == 137)
+        au->mastering = true;
+    if (au->t35.empty())
+    {
+      if (const auto vivid = CHevcSei::FindHdrVividSeiMessage(buf, messages))
+      {
+        const CHevcSei* sei = *vivid;
+        if (sei->m_payloadOffset + sei->m_payloadSize <= buf.size())
+          au->t35.assign(buf.begin() + sei->m_payloadOffset,
+                         buf.begin() + sei->m_payloadOffset + sei->m_payloadSize);
+      }
+    }
+  }
+}
+
+void ScanUnits(const uint8_t* data, size_t size, int lengthSize, CDVHdrVivid::AccessUnit* au)
+{
+  if (!data || !size || lengthSize < 0 || lengthSize > 4)
+    return;
+  if (lengthSize > 0)
+  {
+    size_t pos = 0;
+    while (pos + static_cast<size_t>(lengthSize) <= size)
+    {
+      size_t naluLen = 0;
+      for (int i = 0; i < lengthSize; ++i)
+        naluLen = (naluLen << 8) | data[pos + i];
+      pos += static_cast<size_t>(lengthSize);
+      if (naluLen == 0 || naluLen > size - pos)
+        break;
+      TakeUnit(data + pos, naluLen, au);
+      pos += naluLen;
+    }
+    return;
+  }
+
+  size_t i = 0;
+  while (i + 3 <= size)
+  {
+    if (data[i] == 0 && data[i + 1] == 0 &&
+        (data[i + 2] == 1 || (i + 3 < size && data[i + 2] == 0 && data[i + 3] == 1)))
+    {
+      const size_t scLen = (data[i + 2] == 1) ? 3 : 4;
+      const size_t start = i + scLen;
+      size_t j = start;
+      while (j + 3 <= size &&
+             !(data[j] == 0 && data[j + 1] == 0 &&
+               (data[j + 2] == 1 || (j + 3 < size && data[j + 2] == 0 && data[j + 3] == 1))))
+      {
+        ++j;
+      }
+      const size_t end = (j + 3 <= size) ? j : size;
+      if (end > start)
+        TakeUnit(data + start, end - start, au);
+      i = end;
+    }
+    else
+    {
+      ++i;
+    }
+  }
+}
+
+bool Pq(const AVCodecParameters* parameters)
+{
+  return parameters && parameters->color_trc == AVCOL_TRC_SMPTE2084 &&
+         parameters->color_primaries == AVCOL_PRI_BT2020;
+}
+} // namespace
+
+CDVHdrVivid::AccessUnit CDVHdrVivid::Read(const uint8_t* data, size_t size, int lengthSize)
+{
+  AccessUnit au;
+  ScanUnits(data, size, lengthSize, &au);
+  return au;
+}
+
+bool CDVHdrVivid::MakesLevel1(const std::vector<uint8_t>& t35)
+{
+  struct hdrvivid_dovi_l1 l1;
+  return hdrvivid_dovi_level1_from_t35(t35.data(), t35.size(), &l1);
+}
+
+CDVHdrVivid::Verdict CDVHdrVivid::Judge(const AccessUnit& unit, const AVCodecParameters* parameters)
+{
+  if (unit.dolbyVision)
+    return Verdict::DOLBY_VISION;
+  if (!Pq(parameters))
+    return Verdict::NOT_PQ;
+  if (!unit.picture || unit.t35.empty() || !MakesLevel1(unit.t35))
+    return Verdict::NOT_YET;
+  return Verdict::HDR_VIVID;
+}
+
+const char* CDVHdrVivid::Why(const AccessUnit& unit, const AVCodecParameters* parameters)
+{
+  if (unit.dolbyVision)
+    return "it has units of Dolby Vision";
+  if (!Pq(parameters))
+    return "its colour is not BT.2020 PQ";
+  if (!unit.picture)
+    return "no picture in the access unit";
+  if (unit.t35.empty())
+    return "no HDR Vivid metadata in the access unit";
+  if (!MakesLevel1(unit.t35))
+    return "its HDR Vivid metadata are invalid or unreadable";
+  return "";
+}
+
+bool CDVHdrVivid::Record(const AVCodecParameters* parameters,
+                         AVRational rate,
+                         AVDOVIDecoderConfigurationRecord& record)
+{
+  if (!Pq(parameters))
+    return false;
+  CDVLayerMerge::RpuProbe probe{};
+  probe.rpu = true;
+  probe.rpu_profile = 1;
+  probe.vdr_bit_depth = 12;
+  probe.residual_disabled = true;
+  probe.profile = 8;
+  return CDVLayerMerge::RecordFromRpu(probe, parameters, rate, record) && record.dv_profile == 8 &&
+         record.dv_bl_signal_compatibility_id == 1;
+}

+// RK3588: the hdmi: plugin is not usable here, so a passthrough opens hw: and the AES
+// parameters the plugin would apply are written to the card's IEC958 control.
+void SetIEC958Default(const std::string &card, const std::string &aesParams)
+{
+  unsigned int aes[4] = {0x04, 0x82, 0x00, 0x02};
+  for (const auto &kv : StringUtils::Split(aesParams, ','))
+  {
+    const auto parts = StringUtils::Split(kv, '=');
+    if (parts.size() != 2 || parts[0].size() != 4 || parts[0][0] != 'A')
+      continue;
+    const int idx = parts[0][3] - '0';
+    if (idx < 0 || idx > 3)
+      continue;
+    aes[idx] = static_cast<unsigned int>(std::strtoul(parts[1].c_str(), nullptr, 0));
+  }
+  snd_aes_iec958_t iec958 = {};
+  iec958.status[0] = static_cast<unsigned char>(aes[0]);
+  iec958.status[1] = static_cast<unsigned char>(aes[1]);
+  iec958.status[2] = static_cast<unsigned char>(aes[2]);
+  iec958.status[3] = static_cast<unsigned char>(aes[3]);
+
+  snd_ctl_t *ctl = nullptr;
+  const std::string dev = "hw:" + card;
+  if (snd_ctl_open(&ctl, dev.c_str(), 0) < 0)
+    return;
+  snd_ctl_elem_value_t *val = nullptr;
+  if (snd_ctl_elem_value_malloc(&val) == 0 && val)
+  {
+    snd_ctl_elem_value_set_interface(val, SND_CTL_ELEM_IFACE_PCM);
+    snd_ctl_elem_value_set_name(val, "IEC958 Playback Default");
+    snd_ctl_elem_value_set_iec958(val, &iec958);
+    snd_ctl_elem_write(ctl, val);
+    snd_ctl_elem_value_free(val);
+  }
+  snd_ctl_close(ctl);
+}
+}  // namespace

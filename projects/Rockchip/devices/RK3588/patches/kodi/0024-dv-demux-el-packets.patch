+bool CDVLayerMerge::IsLayer(const AVPacket& enhancement, int enhancementLengthSize)
+{
+  if (!enhancement.data || enhancement.size <= 0 || enhancementLengthSize < 0 ||
+      enhancementLengthSize > 4)
+    return false;
+
+  bool wrapped = false;
+  const bool units =
+      ForEachUnit(enhancement.data, static_cast<size_t>(enhancement.size), enhancementLengthSize,
+                  [&wrapped](const uint8_t* unit, size_t length)
+                  { wrapped |= ((unit[0] >> 1) & 0x3f) == NAL_WRAPPED; });
+  // (a unit of type 63 says the track is the one-track form itself: no enhancement layer has one)
+  return units && !wrapped;
+}

+void CDVELDecoderDRMPRIME::SendLayer(const uint8_t* data, int size, int64_t pts)
+{
+  if (!m_decoder[1] || !data || size <= 0)
+    return;
+
+  // the picture held from before goes first; a decoder and a pairer that are still full mean
+  // this one cannot be kept too: it is dropped, and the pairer drops its base picture
+  if (m_pending[1])
+  {
+    const int ret = Send(1, m_pending[1]);
+    if (ret == AVERROR(EAGAIN))
+    {
+      if (!m_droppedEL)
+        CLog::Log(LOGDEBUG,
+                  "CDVELDecoderDRMPRIME: the enhancement layer is behind: its pictures are dropped");
+      m_droppedEL = true;
+      return;
+    }
+    av_packet_free(&m_pending[1]);
+    if (ret < 0)
+      return;
+  }
+
+  AVPacket* packet = av_packet_alloc();
+  if (!packet || av_new_packet(packet, size) < 0)
+  {
+    av_packet_free(&packet);
+    return;
+  }
+  std::memcpy(packet->data, data, static_cast<size_t>(size));
+  packet->pts = pts;
+  packet->dts = AV_NOPTS_VALUE;
+
+  const int ret = Send(1, packet);
+  if (ret == AVERROR(EAGAIN))
+    m_pending[1] = packet;
+  else
+    av_packet_free(&packet);
+}

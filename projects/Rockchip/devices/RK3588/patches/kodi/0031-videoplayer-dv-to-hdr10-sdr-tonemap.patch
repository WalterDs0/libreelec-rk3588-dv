+//! Output mode for pi-dv-engine (native DV tunnel, HDR10, or 10-bit SDR / WCG-SDR)
+enum EDOLBYVISIONOUTPUTMODE
+{
+  VS_DOLBYVISION_OUT_AUTO = 0,
+  VS_DOLBYVISION_OUT_DV = 1,
+  VS_DOLBYVISION_OUT_HDR10 = 2,
+  VS_DOLBYVISION_OUT_SDR = 3,
+  VS_DOLBYVISION_OUT_WCG_SDR = 4,
+};
+
+//! Target transfer function when tone-mapping Dolby Vision to 10-bit SDR / WCG-SDR
+enum EDOLBYVISIONSDRGAMMA
+{
+  VS_DOLBYVISION_GAMMA_22 = 0,
+  VS_DOLBYVISION_GAMMA_24 = 1,
+};
+
 enum ViewMode
 {
   ViewModeNormal = 0,
@@ -305,6 +322,9 @@ public:
   int m_DolbyVisionCM4Headroom; //!< Auto 2: percent above the display's peak
   bool m_DolbyVisionRemoveL2; //!< the stream's L2 trims left out
   int m_DolbyVisionPeak; //!< the display's peak, nits; 0: not known
+  EDOLBYVISIONOUTPUTMODE m_DolbyVisionOutputMode;
+  int m_DolbyVisionTargetNits; //!< 0: auto (HDR10 passthrough / SDR 203 nits)
+  EDOLBYVISIONSDRGAMMA m_DolbyVisionSDRGamma;
   std::optional<bool>
       m_isDefaultVideoSettings; //!< true: default video settings, false: video specific
 };

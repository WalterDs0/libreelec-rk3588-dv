diff --git a/xbmc/cores/VideoPlayer/DVDDemuxers/HDRVividDovi.c b/xbmc/cores/VideoPlayer/DVDDemuxers/HDRVividDovi.c
index 1111111..2222222 100644
--- a/xbmc/cores/VideoPlayer/DVDDemuxers/HDRVividDovi.c
+++ b/xbmc/cores/VideoPlayer/DVDDemuxers/HDRVividDovi.c
@@ -299,3 +299,133 @@ const AVDOVIMetadata *hdrvivid_dovi_next(struct hdrvivid_dovi_scene *s,
   *size = s->size;
   return s->made;
 }
+
+bool hdr10plus_dovi_level1(const AVDynamicHDRPlus *metadata, struct hdrvivid_dovi_l1 *l1)
+{
+  if (!metadata || !l1 || metadata->num_windows < 1)
+    return false;
+  const AVHDRPlusColorTransformParams *p = &metadata->params[0];
+
+  double peak = 0.0;
+  for (int i = 0; i < 3; ++i) {
+    if (p->maxscl[i].den > 0) {
+      const double v = av_q2d(p->maxscl[i]);
+      if (v > peak)
+        peak = v;
+    }
+  }
+  if (peak <= 0.0) {
+    for (int i = 0; i < p->num_distribution_maxrgb_percentiles && i < 15; ++i) {
+      if (p->distribution_maxrgb[i].percentile.den > 0) {
+        const double v = av_q2d(p->distribution_maxrgb[i].percentile);
+        if (v > peak)
+          peak = v;
+      }
+    }
+  }
+  if (!(peak > 0.0))
+    return false;
+
+  double avg = p->average_maxrgb.den > 0 ? av_q2d(p->average_maxrgb) : 0.0;
+  if (avg < 0.0)
+    avg = 0.0;
+  if (avg > peak)
+    avg = peak;
+
+  double min_lin = 0.0;
+  if (p->num_distribution_maxrgb_percentiles > 0 &&
+      p->distribution_maxrgb[0].percentage <= 1 &&
+      p->distribution_maxrgb[0].percentile.den > 0) {
+    const double v = av_q2d(p->distribution_maxrgb[0].percentile);
+    if (v > 0.0 && v <= avg)
+      min_lin = v;
+  }
+
+  l1->max_pq = code12(pq_from_linear(peak));
+  l1->avg_pq = code12(pq_from_linear(avg));
+  l1->min_pq = code12(pq_from_linear(min_lin));
+  if (l1->avg_pq > l1->max_pq)
+    l1->avg_pq = l1->max_pq;
+  if (l1->min_pq > l1->avg_pq)
+    l1->min_pq = l1->avg_pq;
+  l1->min_raw = l1->min_pq;
+  l1->max_raw = l1->max_pq;
+  l1->avg_raw = l1->avg_pq;
+  return true;
+}
+
+const AVDOVIMetadata *hdr10plus_dovi_next(struct hdrvivid_dovi_scene *s,
+                                          const AVDynamicHDRPlus *hdrplus,
+                                          const AVMasteringDisplayMetadata *mastering,
+                                          const AVContentLightMetadata *light,
+                                          size_t *size, bool *repeated)
+{
+  if (!s || !size || !repeated)
+    return NULL;
+  *repeated = false;
+
+  struct hdrvivid_dovi_l1 l1;
+  const bool has_l1 = hdrplus && hdr10plus_dovi_level1(hdrplus, &l1);
+  if (has_l1) {
+    if (s->made && s->have_l1 &&
+        s->last_l1.min_pq == l1.min_pq &&
+        s->last_l1.max_pq == l1.max_pq &&
+        s->last_l1.avg_pq == l1.avg_pq) {
+      *size = s->size;
+      return s->made;
+    }
+
+    AVMasteringDisplayMetadata default_mastering;
+    if (!mastering || !mastering->has_luminance) {
+      memset(&default_mastering, 0, sizeof(default_mastering));
+      default_mastering.has_luminance = 1;
+      default_mastering.max_luminance = (AVRational){4000, 1};
+      default_mastering.min_luminance = (AVRational){1, 10000};
+      mastering = &default_mastering;
+    }
+
+    size_t bytes = 0;
+    AVDOVIMetadata *first = make_profile81_metadata(l1.min_pq, l1.max_pq, l1.avg_pq,
+                                                    mastering, light, true, &bytes);
+    AVDOVIMetadata *made = first ? av_malloc(bytes) : NULL;
+    if (made) {
+      memcpy(made, first, bytes);
+      av_dovi_get_color(made)->scene_refresh_flag = 0;
+      av_free(s->first);
+      av_free(s->made);
+      s->first = first;
+      s->made = made;
+      s->size = bytes;
+      s->last_l1 = l1;
+      s->have_l1 = true;
+      *size = bytes;
+      return s->first;
+    }
+    av_free(first);
+  }
+
+  if (!s->made) {
+    AVMasteringDisplayMetadata default_mastering;
+    if (!mastering || !mastering->has_luminance) {
+      memset(&default_mastering, 0, sizeof(default_mastering));
+      default_mastering.has_luminance = 1;
+      default_mastering.max_luminance = (AVRational){4000, 1};
+      default_mastering.min_luminance = (AVRational){1, 10000};
+      mastering = &default_mastering;
+    }
+    size_t bytes = 0;
+    AVDOVIMetadata *fallback = make_profile81_metadata(0, 3079, 1000,
+                                                       mastering, light, true, &bytes);
+    if (!fallback)
+      return NULL;
+    s->made = fallback;
+    s->size = bytes;
+    s->have_l1 = false;
+    *repeated = true;
+    *size = bytes;
+    return s->made;
+  }
+  *repeated = true;
+  *size = s->size;
+  return s->made;
+}

+bool CDVDDemuxFFmpeg::ProbeHdr10Plus(CDemuxStream* stream,
+                                     int streamIdx,
+                                     const uint8_t* data,
+                                     int size,
+                                     unsigned int& probed,
+                                     unsigned int done)
+{
+  if (m_dvFromHdr10Plus.count(streamIdx))
+    return true;
+  const auto settings = CServiceBroker::GetSettingsComponent()->GetSettings();
+  if (!settings || !settings->GetBool(CSettings::SETTING_VIDEOPLAYER_DOLBYVISIONFROMHDR10PLUS))
+    return false;
+
+  const AVStream* avStream = m_pFormatContext->streams[streamIdx];
+  auto* video = static_cast<CDemuxStreamVideo*>(stream);
+  bool isHdr10Plus = (video->hdr_type == StreamHdrType::HDR_TYPE_HDR10PLUS);
+  if (!isHdr10Plus)
+  {
+    const CDVHdrVivid::AccessUnit unit = CDVHdrVivid::Read(
+        data, static_cast<size_t>(size), CDVLayerMerge::LengthSize(avStream->codecpar));
+    if (unit.dolbyVision || !unit.hdr10Plus)
+      return false;
+    isHdr10Plus = true;
+  }
+  if (!avStream->codecpar || avStream->codecpar->color_trc != AVCOL_TRC_SMPTE2084 ||
+      avStream->codecpar->color_primaries != AVCOL_PRI_BT2020)
+    return false;
+
+  probed = done;
+  AVDOVIDecoderConfigurationRecord record{};
+  const AVRational rate =
+      av_guess_frame_rate(m_pFormatContext, const_cast<AVStream*>(avStream), nullptr);
+  if (!CDVHdrVivid::Record(avStream->codecpar, rate, record))
+    return true;
+
+  CLog::Log(LOGINFO,
+            "CDVDDemuxFFmpeg: stream {} is HDR10+ without Dolby Vision: promoting to Dolby Vision profile 8.1",
+            streamIdx);
+  m_dvPromoted[streamIdx] = record;
+  m_dvFromHdr10Plus[streamIdx] = true;
+  video->doviFromHdr10Plus = true;
+  PromoteDolbyVision(stream, record, nullptr);
+  return true;
+}
